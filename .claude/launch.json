{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm run build && npm run start"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
